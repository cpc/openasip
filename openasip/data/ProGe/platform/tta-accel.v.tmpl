      assign pmem_rdata  = {dataw_c{1'b0}};
      assign param_b_avalid_out = 1'b0;
      assign param_b_aaddr_out  = {second_pmem_addr_width_g{1'b0}};
      assign param_b_awren_out  = 1'b0;
      assign param_b_astrb_out  = {((second_pmem_data_width_g+7)/8){1'b0}};
      assign param_b_adata_out  = {second_pmem_data_width_g{1'b0}};
      assign param_b_rready_out = 1'b0;
    end
  endgenerate

  almaif_membus_delay #(
    .mem_dataw_g (dataw_c),
    .mem_addrw_g (axi_addr_width_g-2)
  ) imem_delay (
    .clk (clk), .rstx (rstx),
    .s_avalid_in  (imem_avalid),
    .s_aready_out (imem_aready),
    .s_aaddr_in   (axi_aaddr),
    .s_awren_in   (axi_awren),
    .s_astrb_in   (axi_astrb),
    .s_adata_in   (axi_adata),
    .s_rvalid_out (imem_rvalid),
    .s_rready_in  (imem_rready),
    .s_rdata_out  (imem_rdata),
    .m_avalid_out (imem_d_avalid),
    .m_aready_in  (imem_d_aready),
    .m_aaddr_out  (imem_d_aaddr),
    .m_awren_out  (imem_d_awren),
    .m_astrb_out  (imem_d_astrb),
    .m_adata_out  (imem_d_adata),
    .m_rvalid_in  (imem_d_rvalid),
    .m_rready_out (imem_d_rready),
    .m_rdata_in   (imem_d_rdata)
  );

  almaif_axi_expander #(
    .mem_dataw_g  (dataw_c),
    .mem_addrw_g  (imem_axi_addr_width_g),
    .axi_dataw_g  (dataw_c),
    .axi_addrw_g  (axi_addr_width_g),
    .sync_reset_g (sync_reset_g)
  ) imem_expander (
    .clk (clk), .rstx (rstx),
    .axi_avalid_in  (imem_d_avalid),
    .axi_aready_out (imem_d_aready),
    .axi_aaddr_in   (imem_d_aaddr),
    .axi_awren_in   (imem_d_awren),
    .axi_astrb_in   (imem_d_astrb),
    .axi_adata_in   (imem_d_adata),
    .axi_rvalid_out (imem_d_rvalid),
    .axi_rready_in  (imem_d_rready),
    .axi_rdata_out  (imem_d_rdata),
    .mem_avalid_out (axi_imem_avalid_out),
    .mem_aready_in  (axi_imem_aready_in),
    .mem_aaddr_out  (axi_imem_aaddr_out),
    .mem_awren_out  (axi_imem_awren_out),
    .mem_astrb_out  (axi_imem_astrb_out),
    .mem_adata_out  (axi_imem_adata_out),
    .mem_rvalid_in  (axi_imem_rvalid_in),
    .mem_rready_out (axi_imem_rready_out),
    .mem_rdata_in   (axi_imem_rdata_in)
  );

  assign axi_imem_aready_in = INSTR_b_aready_in[0];
  assign INSTR_b_avalid_out[0] = axi_imem_avalid_out;
  assign INSTR_b_aaddr_out[imem_axi_addr_width_g-1:0] = axi_imem_aaddr_out;
  assign INSTR_b_awren_out[0] = axi_imem_awren_out;
  assign INSTR_b_astrb_out[3:0] = axi_imem_astrb_out;
  assign INSTR_b_adata_out[31:0] = axi_imem_adata_out;
  assign axi_imem_rvalid_in = INSTR_b_rvalid_in[0];
  assign INSTR_b_rready_out[0] = axi_imem_rready_out;
  assign axi_imem_rdata_in = INSTR_b_rdata_in[31:0];

  generate
    for (I = 1; I < core_count_g; I = I + 1) begin : imem_broadcast
      assign INSTR_b_avalid_out[I] = axi_imem_avalid_out & axi_imem_awren_out;
      assign INSTR_b_aaddr_out[(I+1)*imem_axi_addr_width_g-1:I*imem_axi_addr_width_g] = axi_imem_aaddr_out;
      assign INSTR_b_awren_out[I] = axi_imem_awren_out;
      assign INSTR_b_astrb_out[4*(I+1)-1:4*I] = axi_imem_astrb_out;
      assign INSTR_b_adata_out[(I+1)*32-1:I*32] = axi_imem_adata_out;
      assign INSTR_b_rready_out[I] = 1'b1;
    end
  endgenerate

  assign INSTR_a_avalid_out = ~core_imem_en_x_in;
  assign tta_aready         = INSTR_a_aready_in;
  assign INSTR_a_aaddr_out  = core_imem_addr_in;
  assign INSTR_a_adata_out  = {(core_count_g*imem_data_width_g){1'b0}};
  assign INSTR_a_astrb_out  = {((imem_data_width_g+7)/8*core_count_g){1'b0}};
  assign INSTR_a_awren_out  = {core_count_g{1'b0}};
  assign INSTR_a_rready_out = (~core_imem_en_x_in) | (~tta_nreset);
  assign tta_rvalid         = INSTR_a_rvalid_in;
  assign core_imem_data_out = INSTR_a_rdata_in;
  assign core_busy          = (~tta_aready) | (~tta_rvalid);
  assign core_busy_out      = core_busy;

endmodule
