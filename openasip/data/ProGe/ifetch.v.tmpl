module ENTITY_STR_ifetch
#(
`include "ENTITY_STR_imem_mau_pkg.vh"
,
`include "ENTITY_STR_globals_pkg.vh"
,
`include "gcu_opcodes_pkg.vh"
,
    parameter no_glock_loopback_g = 1'b0,
    parameter extra_fetch_cycles = 0,
    parameter sync_reset_g = 0,
    parameter debug_logic_g = 0,
    parameter [IMEMADDRWIDTH-1:0] pc_init_g = {IMEMADDRWIDTH{1'b0}}
)
    (
    input[IMEMADDRWIDTH-1:0]    pc_in,
    output[IMEMADDRWIDTH-1:0]   ra_out,
    input[IMEMADDRWIDTH-1:0]    ra_in,
    input   pc_load,
    input   ra_load,
    input[<<placeholder,pc-opcode-len,0>>:0] pc_opcode,
    input[IMEMWIDTHINMAUS*IMEMMAUWIDTH-1:0] imem_data,
    output[IMEMADDRWIDTH-1:0] imem_addr,
    output imem_en_x,
    output[IMEMWIDTHINMAUS*IMEMMAUWIDTH-1:0] fetchblock,
    input   busy,
    output   glock,
    input fetch_en,
    <<placeholder,db-port-declarations>>
    input   clk,
    input   rstx
    );

    reg[IMEMADDRWIDTH-1:0] pc_reg;
    wire[IMEMADDRWIDTH-1:0] pc_wire;
    reg[IMEMADDRWIDTH-1:0] pc_prev_reg;
    reg[IMEMADDRWIDTH-1:0] next_pc;
    wire[IMEMADDRWIDTH-1:0] increased_pc;
    reg[IMEMADDRWIDTH-1:0] return_addr_reg;
    reg[IMEMWIDTHINMAUS*IMEMMAUWIDTH-1:0] instruction_reg;

    wire lock;
    integer reset_cntr;
    reg reset_lock;
    reg mem_en_lock_r;

    <<placeholder,db-signal-declarations>>

    parameter IFETCH_DELAY = 1;

    assign imem_en_x = (fetch_en && !mem_en_lock_r) ? 1'b0 : 1'b1;
    assign imem_addr = pc_wire;
    assign glock = busy | reset_lock | ~(fetch_en | no_glock_loopback_g);
    assign ra_out = return_addr_reg;
    assign fetchblock = instruction_reg;
    assign lock = ~fetch_en | busy | mem_en_lock_r;

    always @(posedge clk or negedge rstx) begin
        if (!sync_reset_g && !rstx) begin
            mem_en_lock_r <= 1'b1;
        end else begin
            if ((sync_reset_g && !rstx) || !db_rstx)
                mem_en_lock_r <= 1'b1;
            else
                mem_en_lock_r <= 1'b0;
        end
    end

    always @(posedge clk or negedge rstx) begin
        if (!sync_reset_g && !rstx) begin
            pc_reg      <= pc_init_g;
            pc_prev_reg <= {IMEMADDRWIDTH{1'b0}};
        end else begin
            if ((sync_reset_g && !rstx) || !db_rstx) begin
                pc_reg      <= db_pc_start;
                pc_prev_reg <= {IMEMADDRWIDTH{1'b0}};
            end else if (!lock) begin
                pc_reg      <= next_pc;
                pc_prev_reg <= pc_reg;
            end
        end
    end

    always @(posedge clk or negedge rstx) begin
        if (!sync_reset_g && !rstx) begin
            return_addr_reg <= {IMEMADDRWIDTH{1'b0}};
        end else begin
            if ((sync_reset_g && !rstx) || !db_rstx) begin
                return_addr_reg <= {IMEMADDRWIDTH{1'b0}};
            end else if (!lock) begin
                if (ra_load)
                    return_addr_reg <= ra_in;
                else if (pc_load && pc_opcode == IFE_CALL)
                    return_addr_reg <= increased_pc;
            end
        end
    end

    always @(posedge clk or negedge rstx) begin
        if (!sync_reset_g && !rstx) begin
            instruction_reg <= {IMEMWIDTHINMAUS*IMEMMAUWIDTH{1'b0}};
            reset_cntr      <= 0;
            reset_lock      <= 1'b1;
        end else begin
            if ((sync_reset_g && !rstx) || !db_rstx) begin
                instruction_reg <= {IMEMWIDTHINMAUS*IMEMMAUWIDTH{1'b0}};
                reset_cntr      <= 0;
                reset_lock      <= 1'b1;
            end else if (!lock) begin
                if (reset_cntr < IFETCH_DELAY)
                    reset_cntr <= reset_cntr + 1;
                else
                    reset_lock <= 1'b0;
                instruction_reg <= imem_data;
            end
        end
    end

    assign pc_wire = (!lock) ? pc_reg : pc_prev_reg;
    assign increased_pc = pc_wire + IMEMWIDTHINMAUS;

    always @(*) begin
        if (pc_load && (pc_opcode == IFE_CALL || pc_opcode == IFE_JUMP))
            next_pc = pc_in;
        else
            next_pc = increased_pc;
    end

    always @(posedge clk or negedge rstx) begin
        if (!sync_reset_g && !rstx) begin
            lockcnt_r  <= 64'd0;
            cyclecnt_r <= 64'd0;
            lockcnt_increment_r <= 0;
            cyclecnt_increment_r <= 0;
        end else begin
            if ((sync_reset_g && !rstx) || !db_rstx) begin
                lockcnt_r  <= 64'd0;
                cyclecnt_r <= 64'd0;
                lockcnt_increment_r <= 0;
                cyclecnt_increment_r <= 0;
            end else if (debug_logic_g && !db_lockreq) begin
                if (lock) begin
                    lockcnt_increment_r <= 1;
                    cyclecnt_increment_r <= 0;
                end else begin
                    lockcnt_increment_r <= 0;
                    cyclecnt_increment_r <= 1;
                end
                lockcnt_r  <= lockcnt_r  + lockcnt_increment_r;
                cyclecnt_r <= cyclecnt_r + cyclecnt_increment_r;
            end
        end
    end

    assign db_cyclecnt = cyclecnt_r;
    assign db_lockcnt  = lockcnt_r;
    assign db_pc       = pc_reg;
    assign db_pc_next  = next_pc;

endmodule
